# ── Database (MySQL) ─────────────────────────────────────────
# Option 1 — Hostinger Business hosting (recommended on Hostinger):
# when the Node.js app runs on the same server as MySQL, use localhost.
DB_HOST=localhost
DB_USER=u123456_user
DB_PASSWORD=your_mysql_password
DB_NAME=u123456_sports
DB_PORT=3306

# Option 2 — single URL (takes effect only when DB_HOST is unset):
# DATABASE_URL="mysql://user:password@host:3306/database"
# (percent-encode special characters in the password, e.g. + → %2B)

# ── Admin ────────────────────────────────────────────────────
# Secret used to sign admin session tokens (HMAC-SHA256, src/lib/auth.ts).
# Optional — set a long random string in production (e.g. `openssl rand -hex 32`).
# ADMIN_SECRET="change-me-to-a-long-random-string"

# Admin account created/updated by `bun scripts/seed.ts` (optional overrides).
# ADMIN_EMAIL="admin@zameersports.shop"
# ADMIN_PASSWORD="Zameer@2025"

# ── Site ─────────────────────────────────────────────────────
# Public site URL used for canonical URLs, sitemap and Open Graph metadata.
# Optional — defaults to https://zameersports.shop
# NEXT_PUBLIC_SITE_URL="https://zameersports.shop"
